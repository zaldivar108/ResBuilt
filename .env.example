# AI Assist providers (both server-side only — never exposed to the browser).
# The proxy (api/ai.js) tries OpenCode Zen FIRST, then falls back to Groq. Set
# either or both; with only one configured it behaves as a single-provider proxy.

# OpenCode Zen — free models (primary). Key from the OpenCode Zen gateway.
# Base URL is https://opencode.ai/zen/v1 (OpenAI-compatible). If unset, the proxy
# uses Groq only.
OPENCODE_API_KEY=your_opencode_zen_api_key_here

# Groq API key (automatic fallback when OpenCode errors / is unset).
# 1. Create a free key at https://console.groq.com/keys
# 2. Local dev: copy this file to .env.local, paste your key(s), and run `vercel dev`
#    (plain `npm run dev` / Vite does NOT run the /api function).
# 3. Production: add these in Vercel → Project → Settings → Environment Variables.
GROQ_API_KEY=your_groq_api_key_here

# O*NET Web Services API key for live "Real job duties" search (server-side only).
# Without it, the app falls back to the bundled ~10-job seed — search still works,
# just with less coverage.
# 1. Register at https://services.onetcenter.org/developer/signup (org approval).
# 2. Generate a key under My Account; O*NET requires it in an X-API-Key header.
# 3. Local dev: put it in .env.local and run `vercel dev`. Production: add
#    ONET_API_KEY in Vercel → Project → Settings → Environment Variables.
ONET_API_KEY=your_onet_api_key_here
